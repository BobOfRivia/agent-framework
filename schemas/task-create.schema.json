{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-framework:task-create:v1",
  "title": "Task create request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "goal",
    "assignee_agent_instance_id",
    "execution",
    "input_refs",
    "budget",
    "review_policy",
    "acceptance_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "assignee_agent_instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "parent_task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "retry_of_task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "enum": [
            "local",
            "cloud"
          ]
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "target": {
                "const": "local"
              }
            }
          },
          "then": {
            "required": [
              "device_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "device_id"
              ]
            }
          }
        }
      ]
    },
    "input_refs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "version"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_runtime_seconds"
      ],
      "properties": {
        "max_model_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_runtime_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "max_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      }
    },
    "review_policy": {
      "enum": [
        "human",
        "auto"
      ]
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "acceptance_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_media_types",
        "criteria"
      ],
      "properties": {
        "required_media_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "result_schema": {
          "type": "object"
        }
      }
    }
  }
}
