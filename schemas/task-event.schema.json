{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-framework:task-event:v1",
  "title": "Durable task event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "space_id",
    "task_id",
    "sequence",
    "type",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "space_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "task.created",
        "task.state_changed",
        "run.started",
        "run.finished",
        "run.lease_lost",
        "tool.prepared",
        "tool.completed",
        "tool.unknown",
        "approval.requested",
        "approval.decided",
        "task.child_created",
        "delegation.updated",
        "artifact.published",
        "budget.updated",
        "budget.exceeded",
        "task.review_requested",
        "task.reviewed"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  }
}
